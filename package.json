{
  "name": "aigpu-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -b && node packages/aigpu-api/scripts/copy-cli.mjs && node -e \"require('fs').copyFileSync('packages/wgsl/src/wgsl-types.d.ts', 'packages/wgsl/dist/wgsl-types.d.ts')\"",
    "typecheck": "tsc -b && pnpm run typecheck:fixtures",
    "typecheck:fixtures": "tsc -p packages/core/tests/tsconfig.create-sampler-types.json && tsc -p packages/core/tests/tsconfig.types.json && tsc -p packages/aigpu-api/tests/uniforms/tsconfig.types.json",
    "docs:generate": "pnpm --filter @aigpu/cli generate:docs",
    "test": "vitest run",
    "test:fast": "vitest run packages/adapter-mock packages/core packages/wgsl packages/render packages/aigpu-api packages/aigpu-cli scripts",
    "test:docker": "bash infra/test-docker/run.sh",
    "test:doctor:docker": "bash infra/test-docker-doctor/run.sh",
    "generate-lit-cube-snapshot": "pnpm exec esbuild scripts/generate-lit-cube-snapshot.ts --bundle --platform=node --format=esm --external:pngjs --external:webgpu --outfile=packages/adapter-node/dist/generate-lit-cube-snapshot.mjs && node packages/adapter-node/dist/generate-lit-cube-snapshot.mjs",
    "bundle-check": "node scripts/check-bundle-size.mjs --experiences",
    "check-bundle-size": "node scripts/check-bundle-size.mjs --experiences",
    "check:filenames": "bash scripts/check-filenames.sh",
    "check:skill-drift": "node packages/aigpu-cli/lib/docs/generate/check-drift.js",
    "validate:agent-integrations": "node scripts/validate-agent-integrations.mjs",
    "validate:workflows": "python3 scripts/validate-workflows.py",
    "install:agent-skills": "node scripts/install-agent-skills.mjs",
    "bump:patch": "pnpm -r exec npm version patch --no-git-tag-version",
    "bump:minor": "pnpm -r exec npm version minor --no-git-tag-version",
    "bump:major": "pnpm -r exec npm version major --no-git-tag-version"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.10.7",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.28.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "webgpu": "0.4.0"
  }
}
